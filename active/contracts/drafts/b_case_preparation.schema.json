{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tpd-navigator:b-case-preparation:0.1.0-draft",
  "description": "B CPU preparation artifact only; proposed A handoff. Not an M2 ModuleResult, review approval or executable JobSpec.",
  "type": "object",
  "required": ["format", "case_id", "case_version", "run_id", "data_mode", "status", "input_sha256", "target", "starting_ligand", "candidates", "artifacts", "runtime", "implementation_sha256", "not_completed"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "tpd-b-case-preparation/0.1.0-draft"},
    "case_id": {"type": "string", "minLength": 1},
    "case_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^b-cpu-"},
    "data_mode": {"const": "real_public_sources_and_cpu_computation"},
    "status": {"const": "cpu_prepared_pending_human_review"},
    "input_sha256": {"$ref": "#/$defs/hash"},
    "target": {"type": "object"},
    "starting_ligand": {"type": "object", "required": ["ccd", "pdb", "attachment_atom", "identity"]},
    "candidates": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "paper_name", "paper_compound_number", "molecule_id", "identity", "origin", "proteins", "prediction", "human_review"],
      "properties": {
        "origin": {"const": "known_reference_reconstruction"},
        "identity": {"type": "object", "required": ["canonical_isomeric_smiles", "inchikey", "formal_charge", "heavy_atom_count", "properties"]},
        "prediction": {"type": "object", "required": ["status", "input", "msa", "model_version", "approval"], "properties": {"status": {"const": "not_run"}, "approval": {"const": "not_granted_by_this_tool"}}},
        "human_review": {"type": "object", "required": ["status", "reviewer"], "properties": {"status": {"const": "pending"}, "reviewer": {"type": "null"}}}
      }
    }},
    "artifacts": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["path", "sha256", "bytes"], "additionalProperties": false,
      "properties": {"path": {"type": "string", "pattern": "^[^/\\\\]+$"}, "sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 1}}
    }},
    "runtime": {"type": "object", "required": ["python", "packages", "elapsed_seconds", "gpu_used", "remote_paid_compute_used"], "properties": {"gpu_used": {"const": false}, "remote_paid_compute_used": {"const": false}}},
    "implementation_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
    "not_completed": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
