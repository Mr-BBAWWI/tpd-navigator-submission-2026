{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tpd-navigator:a-expert-response:0.1.0-draft",
  "type": "object",
  "required": [
    "version",
    "source_sha256",
    "bundle_digest",
    "reviewer_name",
    "review_date",
    "disposition_basis",
    "questions",
    "literature_supplements",
    "authority"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "disposition_basis": {
      "const": "developer_mapping_of_free_text_not_a_signed_approval"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "answer_original",
          "disposition",
          "applied",
          "remaining"
        ],
        "properties": {
          "question_id": {
            "enum": [
              "Q01",
              "Q02",
              "Q03",
              "Q04",
              "Q05"
            ]
          },
          "answer_original": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "const": "opinion_received"
          },
          "applied": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "literature_supplements": {
      "type": "array"
    },
    "authority": {
      "const": {
        "human_approved": false,
        "dispatch_authorized": false,
        "efficacy_claim": "not_established",
        "public_release_ready": false
      }
    }
  },
  "additionalProperties": false
}
