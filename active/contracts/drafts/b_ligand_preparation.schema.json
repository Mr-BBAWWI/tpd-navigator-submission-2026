{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tpd-navigator:b-ligand-preparation:0.1.0-draft",
  "title": "Offline ligand preparation request; no execution approval",
  "type": "object", "additionalProperties": false,
  "required": ["format", "data_mode", "binding", "source_structure", "source_molecule", "model_input", "expected_isomeric_smiles", "selection", "atom_mapping", "chemistry_policy"],
  "properties": {
    "format": {"const": "tpd-ligand-preparation-request/0.1.0-draft"},
    "data_mode": {"enum": ["real", "synthetic_test"]},
    "binding": {"$ref": "#/$defs/binding"},
    "source_structure": {"$ref": "#/$defs/file"},
    "source_molecule": {"$ref": "#/$defs/file"},
    "model_input": {"$ref": "#/$defs/file"},
    "expected_isomeric_smiles": {"type": "string", "minLength": 1},
    "chemistry_policy": {"const": "preserve_input_no_ph_prediction"},
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["auth_chain_id", "auth_seq_id", "insertion_code", "component_id"],
      "properties": {
        "auth_chain_id": {"type": "string", "minLength": 1}, "auth_seq_id": {"type": "integer"},
        "insertion_code": {"type": "string", "maxLength": 1}, "component_id": {"type": "string", "minLength": 1}
      }
    },
    "atom_mapping": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["atom_map", "source_atom_name"],
        "properties": {"atom_map": {"type": "integer", "minimum": 1}, "source_atom_name": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "pattern": "^raw/[^\\\\:]+$"}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["compound_id", "molecule_id", "run_id", "model_rank", "input_sha256", "structure_sha256"],
      "properties": {
        "compound_id": {"type": "string", "minLength": 1}, "molecule_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1}, "model_rank": {"type": "integer", "minimum": 0},
        "input_sha256": {"$ref": "#/$defs/sha"}, "structure_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
