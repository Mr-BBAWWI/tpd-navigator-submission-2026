{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tpd-navigator:b-boltz-output-manifest:0.1.0-draft",
  "type": "object", "additionalProperties": false,
  "required": ["format", "origin", "compound_id", "molecule_id", "receipt_digest", "input_sha256", "record_id", "model_rank", "runtime_reported", "files"],
  "properties": {
    "format": {"const": "tpd-boltz-output-manifest/0.1.0-draft"},
    "origin": {"enum": ["synthetic_test", "boltz_inference_reported"]},
    "compound_id": {"type": "string"}, "molecule_id": {"type": "string"},
    "receipt_digest": {"$ref": "#/$defs/hash"}, "input_sha256": {"$ref": "#/$defs/hash"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "model_rank": {"type": "integer", "minimum": 0},
    "runtime_reported": {"type": "object", "additionalProperties": false, "required": ["boltz_version", "weights_sha256", "run_id"], "properties": {
      "boltz_version": {"const": "2.2.1"}, "weights_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "run_id": {"type": "string", "minLength": 1}
    }},
    "files": {"type": "object", "additionalProperties": false, "required": ["input", "structure", "confidence"], "properties": {
      "input": {"$ref": "#/$defs/file"}, "structure": {"$ref": "#/$defs/file"},
      "confidence": {"anyOf": [{"$ref": "#/$defs/file"}, {"type": "null"}]}
    }}
  },
  "allOf": [{"if": {"properties": {"origin": {"const": "boltz_inference_reported"}}}, "then": {"properties": {"runtime_reported": {"properties": {"weights_sha256": {"$ref": "#/$defs/hash"}}}}}}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": {
      "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.(yaml|cif|json)$"}, "sha256": {"$ref": "#/$defs/hash"}
    }}
  }
}
