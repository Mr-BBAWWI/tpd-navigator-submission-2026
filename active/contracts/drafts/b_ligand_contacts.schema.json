{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tpd-navigator:b-ligand-contacts:0.1.0-draft",
  "title": "Contact diagnostics on a prepared complex; incomplete chemical validation",
  "type": "object", "additionalProperties": false,
  "required": ["format", "data_mode", "binding", "input_digest", "prior_quality_digest", "status", "models", "method", "protein_name_alias_count", "limitations", "hydrogen_orientation", "probe_atom_typing", "human_review", "automatic_acceptance", "whole_structure_validated", "digest"],
  "properties": {
    "format": {"const": "tpd-ligand-contact-report/0.1.0-draft"},
    "data_mode": {"enum": ["real", "synthetic_test"]},
    "binding": {"$ref": "#/$defs/binding"},
    "input_digest": {"$ref": "#/$defs/sha"}, "prior_quality_digest": {"$ref": "#/$defs/sha"}, "digest": {"$ref": "#/$defs/sha"},
    "status": {"enum": ["completed_with_limits", "failed_or_partial"]},
    "models": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/model"}},
    "method": {"const": "RDKit H directions, exact dictionary X-ray/neutron H lengths, unchanged protein H and all heavy coordinates"},
    "protein_name_alias_count": {"type": "integer", "minimum": 0},
    "limitations": {"const": ["INPUT_PROTONATION_NOT_PREDICTED", "LIGAND_H_ORIENTATION_UNOPTIMIZED", "ATOM_TYPING_REQUIRES_REVIEW", "PROTEIN_H_REUSED_FROM_PRIOR_REDUCE2", "PROBE_INTERNAL_COORDINATE_ROUNDING", "NO_WHOLE_STRUCTURE_OR_EFFICACY_APPROVAL"]},
    "hydrogen_orientation": {"const": "unoptimized"}, "probe_atom_typing": {"const": "review_required"},
    "human_review": {"const": "pending"}, "automatic_acceptance": {"const": false}, "whole_structure_validated": {"const": false}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["compound_id", "molecule_id", "run_id", "model_rank", "input_sha256", "structure_sha256"],
      "properties": {"compound_id": {"type": "string", "minLength": 1}, "molecule_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "model_rank": {"type": "integer", "minimum": 0}, "input_sha256": {"$ref": "#/$defs/sha"}, "structure_sha256": {"$ref": "#/$defs/sha"}}
    },
    "atom": {"type": "array", "minItems": 6, "maxItems": 6, "prefixItems": [{"type": "string"}, {"type": "integer"}, {"type": "string"}, {"type": "string"}, {"type": "string"}, {"type": "string"}]},
    "disagreement": {
      "type": "object", "additionalProperties": false, "required": ["name", "atom_map", "rdkit_acceptor", "probe_acceptor", "rdkit_donor", "probe_attached_h_donor", "restraint_h_bond_type"],
      "properties": {"name": {"type": "string"}, "atom_map": {"type": "integer", "minimum": 1}, "rdkit_acceptor": {"type": "boolean"}, "probe_acceptor": {"type": "boolean"}, "rdkit_donor": {"type": "boolean"}, "probe_attached_h_donor": {"type": "boolean"}, "restraint_h_bond_type": {"type": ["string", "null"]}}
    },
    "typing": {
      "type": "object", "additionalProperties": false, "required": ["status", "all_atom_count", "ligand_atom_count", "missing_atom_types", "role_disagreements", "probe_coordinate_rounding_max_A", "meaning"],
      "properties": {"status": {"enum": ["incomplete", "review_required"]}, "all_atom_count": {"type": "integer", "minimum": 1}, "ligand_atom_count": {"type": "integer", "minimum": 1}, "missing_atom_types": {"type": "array", "items": {"$ref": "#/$defs/atom"}}, "role_disagreements": {"type": "array", "items": {"$ref": "#/$defs/disagreement"}}, "probe_coordinate_rounding_max_A": {"type": "number", "minimum": 0, "exclusiveMaximum": 0.000867}, "meaning": {"type": "string"}}
    },
    "direction": {
      "type": "object", "additionalProperties": false, "required": ["execution_status", "error", "typing", "elapsed_seconds"],
      "properties": {"execution_status": {"enum": ["completed", "failed"]}, "error": {"type": ["string", "null"]}, "typing": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/typing"}]}, "elapsed_seconds": {"type": "number", "minimum": 0}}
    },
    "pair": {
      "type": "object", "additionalProperties": false, "required": ["atoms", "types", "gap_A", "directions"],
      "properties": {"atoms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/atom"}}, "types": {"type": "array", "uniqueItems": true, "items": {"enum": ["bo", "hb", "wh", "so", "cc", "wc"]}, "contains": {"const": "bo"}}, "gap_A": {"type": "number"}, "directions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["forward", "reverse"]}}}
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["hydrogen_convention", "model_sha256", "directions", "bad_overlap_pair_count", "bad_overlap_pairs", "both_directions_completed", "coverage", "ligand_hydrogen_count"],
      "properties": {"hydrogen_convention": {"enum": ["xray", "nuclear"]}, "model_sha256": {"$ref": "#/$defs/sha"}, "directions": {"type": "object", "additionalProperties": false, "required": ["forward", "reverse"], "properties": {"forward": {"$ref": "#/$defs/direction"}, "reverse": {"$ref": "#/$defs/direction"}}}, "bad_overlap_pair_count": {"type": ["integer", "null"], "minimum": 0}, "bad_overlap_pairs": {"type": "array", "items": {"$ref": "#/$defs/pair"}}, "both_directions_completed": {"type": "boolean"}, "coverage": {"const": "incomplete"}, "ligand_hydrogen_count": {"type": "integer", "minimum": 0}}
    }
  }
}
