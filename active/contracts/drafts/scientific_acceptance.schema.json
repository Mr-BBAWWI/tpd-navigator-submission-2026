{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tpd-navigator:scientific-acceptance-submission:2",
  "type": "object",
  "required": ["kind", "payload"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": ["decision", "statement", "compute"]
    },
    "payload": {}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "statement"}}, "required": ["kind"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/statement"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "compute"}}, "required": ["kind"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/compute"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "decision"}}, "required": ["kind"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/decision"}}}
    }
  ],
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["artifact_id", "version", "sha256", "media_type", "schema_id", "provenance"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1},
        "schema_id": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "statement": {
      "type": "object",
      "required": ["text", "locator"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 50000},
        "locator": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "compute": {
      "type": "object",
      "required": ["candidate_ids", "analog_ids"],
      "additionalProperties": false,
      "properties": {
        "candidate_ids": {
          "type": ["array", "null"],
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "analog_ids": {
          "type": ["array", "null"],
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "kind", "ligand_maps", "protein_atom_ids", "required"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {
          "enum": ["directional_hbond", "salt_bridge", "aromatic", "hydrophobic", "proximity"]
        },
        "ligand_maps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "protein_atom_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[^:]+:[^:]+:[^:]+:[^:]+$"}
        },
        "required": {"type": "boolean"}
      }
    },
    "decisionBase": {
      "type": "object",
      "required": ["kind", "action", "intent", "reason", "expected_policy_revision", "data"],
      "properties": {
        "kind": {"type": "string"},
        "action": {"enum": ["accept", "reject", "defer"]},
        "intent": {"type": "string", "minLength": 1, "maxLength": 2000},
        "reason": {"type": "string", "minLength": 1, "maxLength": 10000},
        "expected_policy_revision": {"type": "integer", "minimum": 0},
        "data": {"type": "object"}
      }
    },
    "decision": {
      "oneOf": [
        {"$ref": "#/$defs/numericalDecision"},
        {"$ref": "#/$defs/parentDecision"},
        {"$ref": "#/$defs/siteDecision"},
        {"$ref": "#/$defs/interactionDecision"},
        {"$ref": "#/$defs/calibrationDecision"},
        {"$ref": "#/$defs/microstateDecision"},
        {"$ref": "#/$defs/synthesisDecision"},
        {"$ref": "#/$defs/ternaryDecision"},
        {"$ref": "#/$defs/proteinHydrogenReviewDecision"},
        {"$ref": "#/$defs/followupGeometryReviewDecision"},
        {"$ref": "#/$defs/formalDecision"}
      ]
    },
    "numericalDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "numerical_criteria"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["values", "minimum_reduction_reviewed"],
              "additionalProperties": false,
              "properties": {
                "values": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "parent_funnel_min": {"type": "integer", "minimum": 1, "maximum": 10},
                    "parent_funnel_max": {"type": "integer", "minimum": 1, "maximum": 10},
                    "modifiable_sites_min": {"type": "integer", "minimum": 1},
                    "distinct_graphs_per_site_min": {"type": "integer", "minimum": 1},
                    "broad_families_min": {"type": "integer", "minimum": 1},
                    "panel_min": {"type": "integer", "minimum": 1, "maximum": 20},
                    "panel_max": {"type": "integer", "minimum": 1, "maximum": 20},
                    "calibration_seeds_min": {"type": "integer", "minimum": 1},
                    "novel_ternary_repeats_min": {"type": "integer", "minimum": 2}
                  }
                },
                "minimum_reduction_reviewed": {"type": "boolean"},
                "reduction_justification": {"type": "string", "minLength": 1, "maxLength": 10000},
                "reduction_source_ref": {"$ref": "#/$defs/artifactRef"}
              }
            }
          }
        }
      ]
    },
    "parentDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "parent_funnel"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["parents"],
              "additionalProperties": false,
              "properties": {
                "parents": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "required": ["parent_id", "expert_selected", "rationale", "source_ref"],
                    "additionalProperties": false,
                    "properties": {
                      "parent_id": {"type": "string", "minLength": 1},
                      "expert_selected": {"const": true},
                      "rationale": {"type": "string", "minLength": 1},
                      "source_ref": {"$ref": "#/$defs/artifactRef"}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "siteDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "site_policy"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["parent_id", "sites"],
              "additionalProperties": false,
              "properties": {
                "parent_id": {"type": "string", "minLength": 1},
                "sites": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["atom_map", "state", "allowed_rule_ids", "rationale", "source_ref", "allow_release_protected"],
                    "additionalProperties": false,
                    "properties": {
                      "atom_map": {"type": "integer", "minimum": 1},
                      "state": {"enum": ["MODIFIABLE", "PROTECTED", "UNKNOWN"]},
                      "original_state": {"enum": ["MODIFIABLE", "PROTECTED", "UNKNOWN"]},
                      "expert_classification": {"type": "boolean"},
                      "allowed_rule_ids": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1}
                      },
                      "rationale": {"type": "string", "minLength": 1},
                      "source_ref": {"$ref": "#/$defs/artifactRef"},
                      "allow_release_protected": {"type": "boolean"},
                      "release_justification": {"type": "string", "minLength": 1},
                      "release_source_ref": {"$ref": "#/$defs/artifactRef"}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "interactionDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "interaction_requirements"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["parent_id", "analog_id", "requirements"],
              "additionalProperties": false,
              "properties": {
                "parent_id": {"type": "string", "minLength": 1},
                "analog_id": {"type": "string", "minLength": 1},
                "requirements": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/requirement"}
                }
              }
            }
          }
        }
      ]
    },
    "calibrationDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "calibration_criterion"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["metric", "threshold", "comparison", "expected_seeds", "scope"],
              "additionalProperties": false,
              "properties": {
                "metric": {"type": "string", "minLength": 1},
                "threshold": {"type": "number"},
                "comparison": {"enum": ["max_lte", "min_gte"]},
                "expected_seeds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 0}
                },
                "scope": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      ]
    },
    "microstateDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "microstate_decision"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["state_choices", "pH_conditions"],
              "additionalProperties": false,
              "properties": {
                "state_choices": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {"type": "integer", "minimum": 0}
                },
                "pH_conditions": {
                  "type": "object",
                  "required": ["pH", "description"],
                  "additionalProperties": false,
                  "properties": {
                    "pH": {"type": "number", "minimum": 0, "maximum": 14},
                    "description": {"type": "string", "minLength": 1, "maxLength": 1000}
                  }
                },
                "population_evidence": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {"$ref": "#/$defs/microstatePopulationEvidence"}
                }
              }
            }
          }
        }
      ]
    },
    "microstatePopulationEvidence": {
      "type": "object",
      "required": ["analog_id", "report_id", "state_index", "pH", "evidence_ref", "locator", "review_ref", "interpretation"],
      "additionalProperties": false,
      "properties": {
        "analog_id": {"type": "string", "minLength": 1},
        "report_id": {"type": "string", "minLength": 1},
        "state_index": {"type": "integer", "minimum": 0},
        "pH": {"type": "number", "minimum": 0, "maximum": 14},
        "evidence_ref": {"$ref": "#/$defs/artifactRef"},
        "locator": {"type": "string", "pattern": "^/", "maxLength": 2000},
        "review_ref": {"$ref": "#/$defs/artifactRef"},
        "interpretation": {"type": "string", "minLength": 1, "maxLength": 10000}
      }
    },
    "blockedSmarts": {
      "type": "object",
      "required": ["id", "smarts", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "smarts": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "synthesisDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "synthesis_policy"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["chosen_candidate_ids", "candidate_policies", "exact_route_records"],
              "additionalProperties": false,
              "properties": {
                "chosen_candidate_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "candidate_policies": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["candidate_id", "blocked_smarts"],
                    "additionalProperties": false,
                    "properties": {
                      "candidate_id": {"type": "string", "minLength": 1},
                      "blocked_smarts": {
                        "type": "array",
                        "items": {"$ref": "#/$defs/blockedSmarts"}
                      }
                    }
                  }
                },
                "exact_route_records": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["candidate_id", "source_ref", "locator"],
                    "additionalProperties": false,
                    "properties": {
                      "candidate_id": {"type": "string", "minLength": 1},
                      "source_ref": {"$ref": "#/$defs/artifactRef"},
                      "locator": {"type": "string", "pattern": "^/"}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ternaryDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "ternary_criterion"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["chosen_candidates", "expected_seeds", "geometry"],
              "additionalProperties": false,
              "properties": {
                "chosen_candidates": {
                  "type": "object",
                  "required": ["CRBN", "VHL"],
                  "additionalProperties": false,
                  "properties": {
                    "CRBN": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                    "VHL": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                  }
                },
                "expected_seeds": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
                },
                "geometry": {
                  "type": "object",
                  "required": ["accepted", "metric", "comparison", "threshold", "reference_free", "rationale", "source_ref"],
                  "additionalProperties": false,
                  "properties": {
                    "accepted": {"type": "boolean"},
                    "metric": {"type": "string", "minLength": 1},
                    "comparison": {"enum": ["max_lte", "min_gte"]},
                    "threshold": {"type": "number"},
                    "reference_free": {"const": true},
                    "rationale": {"type": "string", "minLength": 1},
                    "source_ref": {"$ref": "#/$defs/artifactRef"}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "proteinHydrogenReviewDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "protein_hydrogen_review"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["evidence_ref", "accepted", "rationale", "source_ref"],
              "additionalProperties": false,
              "properties": {
                "evidence_ref": {"$ref": "#/$defs/artifactRef"},
                "accepted": {"type": "boolean"},
                "rationale": {"type": "string", "minLength": 1, "maxLength": 10000},
                "source_ref": {"$ref": "#/$defs/artifactRef"}
              }
            }
          }
        }
      ]
    },
    "followupGeometryReviewDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "followup_geometry_review"},
            "action": {"const": "accept"},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "required": ["branches", "source_ref"],
              "additionalProperties": false,
              "properties": {
                "branches": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "required": ["candidate_id", "e3_type", "clash_definition", "rationale", "seed_reviews"],
                    "additionalProperties": false,
                    "properties": {
                      "candidate_id": {"enum": ["D-99b12e64986a", "D-b39273b7a53b"]},
                      "e3_type": {"enum": ["CRBN", "VHL"]},
                      "clash_definition": {"type": "string", "minLength": 1, "maxLength": 10000},
                      "rationale": {"type": "string", "minLength": 1, "maxLength": 10000},
                      "seed_reviews": {
                        "type": "array",
                        "minItems": 5,
                        "maxItems": 5,
                        "items": {
                          "type": "object",
                          "required": ["seed", "topology_label", "severe_clash_acceptable", "rationale", "evidence_ref"],
                          "additionalProperties": false,
                          "properties": {
                            "seed": {"enum": [23, 41, 61, 79, 97]},
                            "topology_label": {"type": "string", "minLength": 1, "maxLength": 1000},
                            "severe_clash_acceptable": {"type": "boolean"},
                            "rationale": {"type": "string", "minLength": 1, "maxLength": 10000},
                            "evidence_ref": {"$ref": "#/$defs/artifactRef"}
                          }
                        }
                      }
                    }
                  }
                },
                "source_ref": {"$ref": "#/$defs/artifactRef"}
              }
            }
          }
        }
      ]
    },
    "formalDecision": {
      "allOf": [
        {"$ref": "#/$defs/decisionBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "formal_decision"},
            "action": {"enum": ["accept", "reject", "defer"]},
            "intent": true,
            "reason": true,
            "expected_policy_revision": true,
            "data": {
              "type": "object",
              "maxProperties": 0,
              "additionalProperties": false
            }
          }
        }
      ]
    }
  }
}
