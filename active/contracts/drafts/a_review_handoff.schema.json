{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:tpd-navigator:a-review-handoff:0.1.0-draft",
  "description":"Registered B review input or human-review preparation. Neither grants G1/compute authority.",
  "$defs":{
    "ref":{"$ref":"urn:tpd-navigator:module-boundary:0.1.0#/$defs/ArtifactRef"},
    "authority":{"type":"object","additionalProperties":false,"required":["human_approved","dispatch_authorized","formal_phase1_result"],"properties":{"human_approved":{"const":false},"dispatch_authorized":{"const":false},"formal_phase1_result":{"const":false}}},
    "pending":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["id","owner","status","value","reason"],"properties":{"id":{"enum":["phase1","execution_scope","pharmacy_reviewer","gpu_result"]},"owner":{"type":"string","minLength":1},"status":{"const":"pending"},"value":{"type":"null"},"reason":{"type":"string","minLength":1}}}}
  },
  "oneOf":[
    {"type":"object","additionalProperties":false,
     "required":["format","version","id","project_id","run_id","dossier_id","dossier_ref","snapshot","created_at","material_digest","source_evidence_digest","files","exchange_ref","reconciled_ref","pending_inputs","authority"],
     "properties":{
       "format":{"const":"tpd-ab-review-input/0.1.0-draft"},"version":{"type":"string"},"id":{"type":"string","pattern":"^binput-[a-f0-9]{32}$"},
       "project_id":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1},"dossier_id":{"type":"string","minLength":1},
       "dossier_ref":{"$ref":"#/$defs/ref"},"snapshot":{"type":"object"},"created_at":{"type":"string"},
       "material_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source_evidence_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
       "files":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/ref"}},
       "exchange_ref":{"$ref":"#/$defs/ref"},"reconciled_ref":{"$ref":"#/$defs/ref"},"pending_inputs":{"$ref":"#/$defs/pending"},"authority":{"$ref":"#/$defs/authority"}
     }},
    {"type":"object","additionalProperties":false,
     "required":["format","b_input_id","input_ref","current_input","subject","meaning","candidates","shared_hypothesis","literature_reconciliation","workflow","pending_inputs","ready_for_execution","human_approved","dispatch_authorized"],
     "properties":{
       "format":{"const":"tpd-human-review-preparation/0.1.0-draft"},"b_input_id":{"type":"string","pattern":"^binput-[a-f0-9]{32}$"},
       "input_ref":{"$ref":"#/$defs/ref"},"current_input":{"type":"boolean"},"subject":{"type":"string","minLength":1},"meaning":{"type":"string","minLength":1},
       "candidates":{"type":"array","minItems":1},"shared_hypothesis":{"type":"object"},"literature_reconciliation":{"type":"object"},
       "workflow":{"type":["object","null"]},"pending_inputs":{"$ref":"#/$defs/pending"},
       "ready_for_execution":{"const":false},"human_approved":{"const":false},"dispatch_authorized":{"const":false}
     }}
  ]
}
