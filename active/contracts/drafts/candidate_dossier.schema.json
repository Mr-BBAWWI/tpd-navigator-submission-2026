{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:tpd-navigator:candidate-dossier:0.1.0-draft",
  "description":"A consumer of B's draft CPU package. No Phase1Result or approval is produced.",
  "type":"object",
  "additionalProperties":false,
  "required":["format","id","project_id","run_id","created_at","case_id","snapshot","status","handoff_ref","link_plan_ref","artifact_refs","anchors","analysis_ids","candidates","planned_candidates","authority","limitations"],
  "properties":{
    "format":{"const":"tpd-candidate-dossier/0.1.0-draft"},
    "builder_version":{"type":"string"},
    "id":{"type":"string","pattern":"^dossier-[0-9a-f]{32}$"},
    "project_id":{"type":"string"},"run_id":{"type":"string"},"created_at":{"type":"string"},"case_id":{"type":"string"},
    "snapshot":{"type":"object","required":["revision","bundle_ref","target_ref","target_query_ref","data_mode"]},
    "status":{"const":"imported_pending_joint_review"},
    "handoff_ref":{"type":"object"},"link_plan_ref":{"type":"object"},"artifact_refs":{"type":"object"},
    "anchors":{"type":"object","minProperties":1},
    "analysis_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "candidates":{"type":"array","minItems":1,"items":{"type":"object","required":["id","paper_name","paper_compound_number","origin","pdb","ccd","molecule_id","identity","anchors","attachment","literature_evidence","files","stages","missing"],"properties":{"origin":{"const":"known_reference_reconstruction"},"stages":{"type":"object","required":["gpu","pharmacy_review","g1","report"],"properties":{"gpu":{"const":"not_run"},"pharmacy_review":{"const":"pending"},"g1":{"const":"not_approved"},"report":{"const":"internal_dossier_only"}}}}}},
    "planned_candidates":{"type":"array"},
    "authority":{"const":{"human_approved":false,"dispatch_authorized":false,"formal_phase1_result":false}},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string"}}
  }
}
